# Copy to .env and fill in. Everything except SECRET_KEY is optional for a local demo.
SECRET_KEY=change-me
# ---- Database ----
# 0 = real MongoDB (data is saved permanently)   1 = in-memory demo DB (data is LOST on restart)
USE_MOCK_DB=0
# Local MongoDB:   mongodb://localhost:27017
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=mongodb://localhost:27017
DB_NAME=healthguard
# 1 = if MongoDB is unreachable, continue with a temporary in-memory DB instead of stopping (live-demo safety net; data NOT saved)
DB_FALLBACK_TO_MOCK=0
# Google Maps JavaScript API key (Maps JavaScript API + Places enabled)
GOOGLE_MAPS_API_KEY=
# Twilio SMS (if empty, SMS is only printed in the console = simulation mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
COLLEGE_AUTHORITY_PHONE=+91XXXXXXXXXX
HOSPITAL_PHONE=+91XXXXXXXXXX
# Firebase service-account JSON path (optional cloud backup to Firestore)
FIREBASE_CREDENTIALS=
# The user who registers with this email sees the Admin/College dashboard
ADMIN_EMAIL=admin@college.edu
